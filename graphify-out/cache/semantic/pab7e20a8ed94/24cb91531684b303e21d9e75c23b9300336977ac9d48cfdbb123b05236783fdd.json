{"nodes": [{"id": "readme_site_overview", "label": "DelcoTech Website README", "file_type": "document", "source_file": "README.txt", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Setup and maintenance guide for the static DelcoTech Software & AI Solutions site; no npm, build tools, API keys or backend needed to run it."}, {"id": "readme_quick_start", "label": "Quick Start (static hosting)", "file_type": "concept", "source_file": "README.txt", "source_location": "L4-8", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Open index.html in a browser or upload the folder contents to public_html / any static-site host."}, {"id": "readme_prelaunch_checklist", "label": "Before Go-Live Checklist", "file_type": "concept", "source_file": "README.txt", "source_location": "L10-25", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Set real WhatsApp number and email in CONFIG, verify pricing/terms (50% deposit, two revision rounds, VAT), brand name, test enquiry, and confirm POPIA privacy notice. Placeholder contact details from the original site are deliberately left blank."}, {"id": "readme_config_object", "label": "CONFIG object in script.js", "file_type": "concept", "source_file": "README.txt", "source_location": "L13-17", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Holds whatsapp and email settings and editable site content (pricing, services, steps)."}, {"id": "readme_changing_the_site", "label": "Changing the Site (file responsibilities)", "file_type": "concept", "source_file": "README.txt", "source_location": "L27-36", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Content/pricing/contacts live in script.js, design in style.css, structure/FAQ/metadata in index.html."}, {"id": "readme_promo_film", "label": "Promo film assets (See it in action)", "file_type": "concept", "source_file": "README.txt", "source_location": "L33-36", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Landscape mp4 + poster for desktop/tablet, vertical mp4 + poster for phones; script.js picks the variant; replace files keeping same names to update."}, {"id": "readme_enquiry_flow", "label": "How Enquiries Work (WhatsApp / email / copy fallback)", "file_type": "concept", "source_file": "README.txt", "source_location": "L38-50", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Static site with no server: opens WhatsApp prefilled, else mailto, else copy-only preview. Form stores nothing and transmits no data to a server."}, {"id": "readme_accessibility", "label": "Accessibility and Maintenance", "file_type": "concept", "source_file": "README.txt", "source_location": "L52-58", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Skip link, labelled fields, keyboard menu, focus states, native FAQ disclosure, reduced-motion support, search/social metadata, Google Fonts with system fallback."}, {"id": "readme_motion_gsap", "label": "Motion (GSAP 3.15)", "file_type": "concept", "source_file": "README.txt", "source_location": "L60-73", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All animation in motion.js using gsap, ScrollTrigger and SplitText vendored into assets/vendor/. Intro, mouse and scroll effects; disabled under prefers-reduced-motion and the page degrades gracefully if GSAP fails to load."}, {"id": "readme_3d_tools_threejs", "label": "3D Tools (Three.js)", "file_type": "concept", "source_file": "README.txt", "source_location": "L75-86", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "tools3d.js renders six service-card models (laptop, chip, chat bubble, browser window, nodes, shield) that react to mouse/hover; feature3d.js renders the 3D DelcoTech logo in the About circle. Only on-screen models are drawn; icons shown without WebGL."}, {"id": "readme_files_list", "label": "Project Files Inventory", "file_type": "concept", "source_file": "README.txt", "source_location": "L88-99", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lists index.html, style.css, script.js, motion.js, tools3d.js, feature3d.js, assets/vendor/three (Three.js 0.186), GSAP vendor files and favicon."}, {"id": "readme_service_cards_3d_models", "label": "Six service card 3D models", "file_type": "concept", "source_file": "README.txt", "source_location": "L77-83", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_about_3d_logo", "label": "3D DelcoTech logo in About circle", "file_type": "concept", "source_file": "README.txt", "source_location": "L84-86", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "readme_site_overview", "target": "readme_quick_start", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.txt", "source_location": "L4", "weight": 1.0}, {"source": "readme_site_overview", "target": "readme_prelaunch_checklist", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.txt", "source_location": "L10", "weight": 1.0}, {"source": "readme_site_overview", "target": "readme_changing_the_site", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.txt", "source_location": "L27", "weight": 1.0}, {"source": "readme_site_overview", "target": "readme_enquiry_flow", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.txt", "source_location": "L38", "weight": 1.0}, {"source": "readme_site_overview", "target": "readme_accessibility", "relation": "references", "confidence": "E